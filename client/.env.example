# Backend API URL (Note: Use VITE_ prefix for Vite apps)
VITE_API_URL=http://localhost:5000/api

# Stripe Publishable Key (for frontend use)
VITE_STRIPE_PUBLISHABLE_KEY=

# Optional: CARTO basemaps API key (free at https://carto.com/basemaps/apikey/). When set, CARTO's Voyager map
# is used as the last fallback if the OpenStreetMap tile servers can't be reached. CARTO's free tier is for
# non-commercial use, so see src/config/mapTiles.ts before launch.
VITE_CARTO_API_KEY=
